### FNF-Specific
# File used for the NG API. Should not be shared with others.
APIStuff.hx
art/build_x32-officialrelease.bat
art/build_x64-officialrelease.bat
art/test_x64-debug-officialrelease.bat

### VS Code
export/*
.vscode/*
.claude/*
.haxelib/*
.hxcpp-cache/
*.code-workspace
# Local history which shouldn't be shared.
.history
.ionide
# ! means a file should be added regardless of it it gets ignored prior.
# Including to allow others to use already set-up configuration tweaked for the project.
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

**/.gradle/
**/app/build/
.DS_Store

# Crash linemaps are generated per build (tools/build_*_symbols.ps1)
assets/linemap/*.bin
assets/linemap/*.objsig

# Local crash-triage scratch (reports, probes, logs)
debughunt/

# SeiunEngine local-only artifacts (not for commit)
server/build/
# 我说这是AI瞎乱写的你信吗？现在是2026年，所以我要使用AI
server/bin/*
!server/bin/.gitkeep
server/logs/*
!server/logs/.gitkeep

server/data/
temp/
server_data/
seiun_online_profile.json
# Sidecar cache of huge streamed charts (ChartCache): runtime data, regenerated on demand.
chart_cache/

# Python bytecode caches (tools/*.py)
__pycache__/
*.pyc

# script diagnostics log written by backend.ScriptLog when the test harness runs
/logs/

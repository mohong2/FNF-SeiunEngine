<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="SeiunEngine" file="SeiunEngine" packageName="com.mohong.Seiunengine" package="com.mohong.Seiunengine" main="Main" version="0.2.2preonline1" company="mo_hong" company-url="https://github.com/mohong2/FNF-SeiunEngine"/>

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" background="#000000" hardware="true" vsync="false" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false" allow-high-dpi="true"/>

	<!--Mobile-specific-->
	<!--allow-high-dpi="false": render at 1280x720 and let the compositor scale, instead of
	    rasterizing at the device's native resolution (2-4x fill-rate savings on phones).
	    depth/stencil="false": flixel's 2D renderer never uses depth/stencil buffers, dropping
	    the extra attachments saves VRAM and bandwidth per frame. Remove them only if a mod
	    relies on DisplayObject masks (openfl implements those with stencil).-->
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" require-shaders="true" allow-high-dpi="true" depth="false" stencil="false"/>

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />
	<!-- Vendored online-client dependency sources (io.colyseus, org.msgpack, tink,
	     json2object, hxjsonast, htmlparser, httpstatus, haxe/net). They are third-party
	     ROOT packages, so they must NOT live under source/: source/import.hx applies to a
	     directory and all its subdirectories, and would leak engine imports into them. -->
	<classpath name="source/_online_libs" />
	
	<!-- PSYCH ENGINE CUSTOMIZATION -->
	<!-- Use the SDL3 backend by default (remove this define to fall back to SDL2) -->
	<define name="lime-sdl3" if="desktop || android" />
	<define name="TOUCH_CONTROLS" if="android || ios" />
	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="ONLINE_ALLOWED"/>

	<define name="LUA_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="CHECK_FOR_UPDATES" if="desktop || mobile" />

	<define name="VIDEOS_ALLOWED" if="web || windows || linux || mac || android || ios" unless="32bits"/>
	<define name="PSYCH_WATERMARKS"/>
	<define name="DARKMODE" if="desktop" />
	<define name="CRASH_HANDLER"/>

	<assets path="assets/preload" rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/preload" rename="assets" exclude="*.mp3"  unless="web"/>
	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/secrets" rename="assets" exclude="*.mp3"  unless="web"/>
	</section>

	<!-- <define name="PRELOAD_ALL" /> -->
	<define name="PRELOAD_ALL" unless="web" />
	<define name="NO_PRELOAD_ALL" unless="PRELOAD_ALL"/>
	
	<library name="videos"        preload="true" />
	<section if="PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="true" />
		<library name="week2"         preload="true" />
		<library name="week3"         preload="true" />
		<library name="week4"         preload="true" />
		<library name="week5"         preload="true" />
		<library name="week6"         preload="true" />
		<library name="week7"         preload="true" />
	</section>
	
	<section if="NO_PRELOAD_ALL">
		<library name="songs"         preload="true" />
		<library name="shared"        preload="true" />
		<library name="week2"         preload="true" />
		<library name="week3"         preload="true" />
		<library name="week4"         preload="true" />
		<library name="week5"         preload="true" />
		<library name="week6"         preload="true" />
		<library name="week7"         preload="true" />
	</section>
	
	<assets path="assets/videos"        library="videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         library="songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         library="songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        library="shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/embed"         library="embed"         exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/embed"         library="embed"         exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/week2"         library="week2"         exclude="*.ogg" if="web"/>
	<assets path="assets/week2"         library="week2"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week3"         library="week3"         exclude="*.ogg" if="web"/>
	<assets path="assets/week3"         library="week3"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week4"         library="week4"         exclude="*.ogg" if="web"/>
	<assets path="assets/week4"         library="week4"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week5"         library="week5"         exclude="*.ogg" if="web"/>
	<assets path="assets/week5"         library="week5"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week6"         library="week6"         exclude="*.ogg" if="web"/>
	<assets path="assets/week6"         library="week6"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week7"         library="week7"         exclude="*.ogg" if="web"/>
	<assets path="assets/week7"         library="week7"         exclude="*.mp3" unless="web"/>
	
	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false'/>
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' />
	<!-- <template path='mods' /> -->
	
	<!-- assets path="CHANGELOG.md" rename='changelog.txt' -->

	<!-- NOTE FOR FUTURE SELF SINCE FONTS ARE ALWAYS FUCKY 
		TO FIX ONE OF THEM, I CONVERTED IT TO OTF. DUNNO IF YOU NEED TO
		THEN UHHH I USED THE NAME OF THE FONT WITH SETFORMAT() ON THE TEXT!!!
		NOT USING A DIRECT THING TO THE ASSET!!!
	-->
	<assets path="assets/fonts"/>
	<assets path="assets/lang"/>
	<!-- 崩溃行号映射(常驻): assets/linemap/*.bin 由 tools\build_*_symbols.ps1 生成并嵌进产物,
	     崩溃报告的每一帧就直接带 [source/文件:行] —— 排查成本远低于省下的那点包体.
	     ⚠ 表是 embed="true", 表本身会改变二进制地址 => 表必须与"同一次构建"的二进制配套.
	     因此任何 release 构建都要走 tools\build_android_symbols.ps1 / tools\build_windows_symbols.ps1
	     (它们重新生成表并用 tools\linemap_compare.py 校验); 直接 lime build 会把上一次的表编进去,
	     给出**错误的行号**, 比没有行号更糟. 目录为空时只是没有行号, 不影响启动. -->
	<assets path="assets/linemap" rename="assets/linemap" include="*.bin" embed="true"/>
	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel"/>
	<haxedev set='webgl'/>

	<haxelib name="flixel-addons"/>
	<!-- hscript-seiun: hscript-iris + improved classes/config + plus inheritance (all MIT) -->
	<haxelib name="hscript-seiun"/>
	<!-- Comment this out to disable extending Haxe classes in scripts (CUSTOM_CLASSES) -->
	<define name="CUSTOM_CLASSES" unless="STRIPPED_COMPILE" />
	<haxedef name="hscriptPos"/>

	<!--In case you want to use the ui package-->
	<haxelib name="flixel-ui" />
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hxvlc" if="desktop || android || ios"/>
	<haxelib name="faxe" if='switch'/>
	<haxelib name="tjson"/>
	<!-- 0.7.3/1.0.4 模组兼容：FlxAnimate 精灵（makeFlxAnimateSprite 等 Lua API） -->
	<!-- 0.7.3/1.0.4 mod compat: FlxAnimate sprites (makeFlxAnimateSprite etc.) -->
	<haxelib name="flxanimate" version="4.0.0"/>
	<define name="flxanimate"/>
	<haxelib name="extension-androidtools" if="android" />
	<haxelib name="discord_rpc" if="desktop"/>
	<!-- <haxelib name="extension-webm" if="VIDEOS_ALLOWED" /> -->
	<!-- <haxelib name="markdown" /> -->
	<!-- <haxelib name="HtmlParser" /> -->

	<!--In case you want to use nape with flixel-->
	<!--<haxelib name="nape-haxe4" />-->

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef name="FLX_NO_GAMEPAD" />-->

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />	

	<!--Allow working memory greater than 1 Gig-->
	<!--haxedef name="HXCPP_GC_BIG_BLOCKS"-->
	
	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<!--Make's-the-Game-use-less-ram-->
	<haxedef name="HXCPP_GC_BIG_BLOCKS" />

	<!--Crash-symbol support for release builds.
	HXCPP_MAP_FILE emits a plain-text .map symbol table (exe is unchanged, no
	size cost). It is the ONLY switch left on here on purpose: it keeps every
	crash report resolvable to a real function name + file:line offline.
	HXCPP_DEBUG_LINK is deliberately OFF because it passes /DEBUG to the linker,
	which makes MSVC write debug directory data into the image - the release exe
	grows from ~29.6 MB to ~47.1 MB. Keep it OFF for official builds.
	When HXCPP_DEBUG_LINK is off the exe has no CodeView (RSDS) record, so
	dbghelp CANNOT auto-pair it with a PDB - the report's "Symbols:" line will say
	SymNone and its inline "<name>+0x..." frames must be ignored. Resolve the
	report's "Fault offset" against ApplicationMain.map instead (see
	docs/CRASH_ROOTCAUSE_20260912.md). Turn HXCPP_DEBUG_LINK back on only for a
	dedicated debugging build where exe size does not matter.-->
	<haxedef name="HXCPP_MAP_FILE" value="ApplicationMain.map" />
	<haxedef name="HXCPP_CPP11" if="cpp" />
	<haxedef name="HXCPP_GC_GENERATIONAL" if="cpp" />
	<haxedef name="HXCPP_ALIGN_ALLOC" if="cpp" /> 
	<haxedef name="HXCPP_NO_ARCH_LEVEL" />

	<!--Debug-only defines were previously forced into release builds here.
		hxcpp enables pointer checks / stack-line info automatically in debug builds,
		so release binaries get the clean fast path again.-->

	<haxedef name="loop_unroll_max_cost" value="25"/>

	<!--Android-Internet-Connection-->
	<config:android permission="android.permission.ACCESS_NETWORK_STATE"/>
	<config:android permission="android.permission.ACCESS_WIFI_STATE"/>
	<config:android permission="android.permission.INTERNET"/>

	<!--Storage permissions for Android 10+ (API 29+)-->
	<config:android permission="android.permission.READ_EXTERNAL_STORAGE" if="android"/>
	<config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" if="android"/>
	<config:android permission="android.permission.MANAGE_EXTERNAL_STORAGE" if="android"/>

	<!--Granular media permissions for Android 13+ (API 33+)-->
	<config:android permission="android.permission.READ_MEDIA_IMAGES" if="android"/>
	<config:android permission="android.permission.READ_MEDIA_VIDEO" if="android"/>
	<config:android permission="android.permission.READ_MEDIA_AUDIO" if="android"/>

	<!--Notifications for Android 13+ (API 33+)-->
	<config:android permission="android.permission.POST_NOTIFICATIONS" if="android"/>

	<!--Floating keyboard button (SeiunOverlay): lets players summon the soft
		keyboard anywhere - TYPE_APPLICATION_OVERLAY requires this special
		permission, which is granted from the system settings page.-->
	<config:android permission="android.permission.SYSTEM_ALERT_WINDOW" if="android"/>
	<config:android extension="org.haxe.extension.SeiunOverlay" if="android"/>

	<!-- SDL3 android java needs compileSdk 33+ (TIRAMISU/RECEIVER_EXPORTED/VibratorManager),
	     which requires AGP 7.4 + gradle 7.5 (AGP 4.x caps at compileSdk 31). -->
	<config:android gradle-version="7.5"/>
	<!-- Android 15 crash investigation: targetSdk lowered back to 28. -->
	<config:android target-sdk-version="28" />
	<config:android gradle-plugin="7.4.2" />
	<!-- AGP 7 uses d8/r8 (dx.bat no longer needed), 34.0.0 is fine -->
	<config:android build-tools-version="34.0.0" />

	<certificate path="key.keystore" password="mohong" alias="SeiunEngine" alias-password="mohong" if="android" unless="debug" />

	<!--Place custom nodes like icons here (higher priority to override the HaxeFlixel icon)-->
	
	<icon path="art/icon16.png" size='16'/>
	<icon path="art/icon32.png" size='32'/>
	<icon path="art/icon64.png" size='64'/>
	<icon path="art/iconOG.png" />
</project>

		"variable": "keyboardDisplay",
		"type": "bool",
		"defaultValue": false
	},
	{
		"nameKey": "option.opponentStrums",
		"defaultName": "Opponent Notes",
		"descKey": "option.opponentStrums.desc",
		"defaultDesc": "If unchecked, opponent notes get hidden.",
		"variable": "opponentStrums",
		"type": "bool",
		"defaultValue": true
	},
	{
		"nameKey": "option.ghostTapping",
		"defaultName": "Ghost Tapping",
		"descKey": "option.ghostTapping.desc",
		"defaultDesc": "If checked, you won't get misses from pressing keys\nwhile there are no notes able to be hit.",
		"variable": "ghostTapping",
		"type": "bool",
		"defaultValue": true
	},
	{
		"nameKey": "option.noReset",
		"defaultName": "Disable Reset Button",
		"descKey": "option.noReset.desc",
		"defaultDesc": "If checked, pressing Reset won't do anything.",
		"variable": "noReset",
		"type": "bool",
		"defaultValue": false
	},
	{
		"nameKey": "option.lastNoteAnimation",
		"defaultName": "Last Note Animation",
		"descKey": "option.lastNoteAnimation.desc",
		"defaultDesc": "If checked, character animation will only use the last pressed note's direction when multiple notes are hit simultaneously, reducing visual twitching.",
		"variable": "lastNoteAnimation",
		"type": "bool",
		"defaultValue": false
	},
	{
		"nameKey": "option.saveReplayData",
		"defaultName": "Save Replay Data",
		"descKey": "option.saveReplayData.desc",
		"defaultDesc": "If checked, the game will record your inputs and save them with your score.\nThis allows you to watch replays later.",
		"variable": "saveReplayData",
		"type": "bool",
		"defaultValue": true
	},
	{
		"nameKey": "option.trackAlpha",
		"defaultName": "Note Underlay Opacity",
		"descKey": "option.trackAlpha.desc",
		"defaultDesc": "Changes the opacity of the note underlay.",
		"variable": "trackAlpha",
		"type": "percent",
		"defaultValue": 0,
		"scrollSpeed": 2,
		"minValue": 0,
		"maxValue": 1,
		"changeValue": 0.1,
		"decimals": 1
	},
	{
		"nameKey": "option.sustainsAsOneNote",
		"defaultName": "Sustains as One Note",
		"descKey": "option.sustainsAsOneNote.desc",
		"defaultDesc": "If checked, Hold Notes can't be pressed if you miss,\nand count as a single Hit/Miss.\nUncheck this if you prefer the old Input System.",
		"variable": "guitarHeroSustains",
		"type": "bool",
		"defaultValue": false
	},
	{
		"nameKey": "option.ratingOffset",
		"defaultName": "Rating Offset",
		"descKey": "option.ratingOffset.desc",
		"defaultDesc": "Changes how late/early you have to hit for a \"Sick!\".\nHigher values mean you have to hit later.",
		"variable": "ratingOffset",
		"type": "int",
		"defaultValue": 0,
		"displayFormat": "%vms",
		"scrollSpeed": 20,
		"minValue": -30,
		"maxValue": 30
	},
	{
		"nameKey": "option.safeFrames",
		"defaultName": "Safe Frames",
		"descKey": "option.safeFrames.desc",
		"defaultDesc": "Changes how many frames you have for\nhitting a note earlier or late.",
		"variable": "safeFrames",
		"type": "float",
		"defaultValue": 10,
		"scrollSpeed": 5,
		"minValue": 2,
		"maxValue": 10,
		"changeValue": 0.1
	},
	{
		"nameKey": "option.marvelousRatings",
		"defaultName": "Marvelous Ratings",
		"descKey": "option.marvelousRatings.desc",
		"defaultDesc": "If checked, a 'Marvelous' rating is added before Sick.",
		"variable": "marvelousRatings",
		"type": "bool",
		"defaultValue": true,
		"onChange": "onChangeMarvelousRatings"
	},
	{
		"nameKey": "option.judgementPreset",
		"defaultName": "Judgement Preset",
		"descKey": "option.judgementPreset.desc",
		"defaultDesc": "Apply a preset judgement timing (Leather Engine / Psych Engine / Friday Night Funkin').\nManually changing any window below will switch this to Custom.",
		"variable": "judgementPreset",
		"type": "string",
		"defaultValue": "Leather Engine",
		"options": [
			"Leather Engine",
			"Psych Engine / Kade Engine",
			"Friday Night Funkin'",
			"Custom"
		],
		"onChange": "onChangeJudgementPreset"
	},
	{
		"nameKey": "option.marvelousWindow",
		"defaultName": "Marvelous! Hit Window",
		"descKey": "option.marvelousWindow.desc",
		"defaultDesc": "Changes the amount of time you have\nfor hitting a \"Marvelous\" in milliseconds.\n(Manually editing sets Judgement Preset to Custom)",

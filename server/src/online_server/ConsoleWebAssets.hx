olid var(--border);border-radius:8px;color:var(--text);padding:9px 10px;font-size:13px;font-family:inherit}\r\ninput:focus,textarea:focus,select:focus{outline:none;border-color:var(--accent)}\r\n.row{display:flex;gap:8px;align-items:center;margin-top:10px}\r\n.row input{flex:1}\r\n.hint{color:var(--dim);font-size:12px;margin:12px 0 0}\r\n.login-msg{min-height:18px;font-size:12px;color:var(--bad);margin:10px 0 0}\r\n\r\n/* ---------- shell ---------- */\r\n.app{display:flex;flex-direction:column;height:100vh}\r\n/* ---------- local read-only banner (D-R3-5) ---------- */\r\n.local-ro{flex:0 0 auto;display:flex;align-items:center;justify-content:center;gap:8px;padding:7px 14px;background:linear-gradient(90deg,rgba(124,92,255,.22),rgba(61,220,151,.16));border-bottom:1px solid var(--border);color:var(--text);font-size:12.5px;letter-spacing:.2px}\r\n.topbar{height:58px;flex:0 0 58px;display:flex;align-items:center;gap:18px;padding:0 18px;border-bottom:1px solid var(--border);background:#0f1218}\r\n.brand{display:flex;align-items:center;gap:10px;cursor:pointer;min-width:210px}\r\n.topnav{display:flex;gap:4px;flex:1}\r\n.topnav a{padding:7px 12px;border-radius:8px;color:var(--muted);font-size:13px;cursor:pointer}\r\n.topnav a:hover{background:#161a22;color:var(--text)}\r\n.topnav a.active{background:var(--accent-soft);color:var(--text)}\r\n.topright{display:flex;align-items:center;gap:10px}\r\n.search{position:relative;display:flex;align-items:center}\r\n.search input{width:210px;padding-right:52px}\r\n.search kbd{position:absolute;right:8px;color:var(--dim);border:1px solid var(--border);border-radius:5px;padding:1px 5px;background:#0d1015}\r\n.icon-btn{position:relative;background:#141821;border:1px solid var(--border);color:var(--text);border-radius:9px;width:36px;height:36px;cursor:pointer}\r\n.icon-btn:hover{border-color:#2f3746}\r\n.badge{position:absolute;top:-6px;right:-6px;background:var(--bad);color:#fff;border-radius:9px;font-size:10px;padding:0 5px;line-height:
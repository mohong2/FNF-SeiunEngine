mily:var(--mono);margin-top:8px}\r\n.stat .foot{color:var(--dim);font-size:11px;margin-top:4px}\r\n.page-title{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:14px}\r\n.page-title h2{margin:0;font-size:19px}\r\n.page-title .desc{color:var(--muted);font-size:12px;margin-top:3px}\r\n\r\n/* ---------- tables ---------- */\r\ntable{width:100%;border-collapse:collapse;font-size:13px}\r\n/* Bilingual headers make wide tables outgrow the card: scroll them instead of clipping. */\r\n.tablewrap{overflow-x:auto;max-width:100%}\r\n.tablewrap th{white-space:nowrap}\r\n/* Keep the action buttons reachable: pin the last column while the rest scrolls. */\r\n.tablewrap .act{position:sticky;right:0;background:var(--card);border-left:1px solid #1b1f28}\r\nth{color:var(--muted);font-weight:500;text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;font-size:12px}\r\ntd{padding:8px 10px;border-bottom:1px solid #1b1f28;vertical-align:middle}\r\ntr:hover td{background:#12151c}\r\ntd.mono,th.mono{font-family:var(--mono);font-size:12px}\r\n.empty{color:var(--dim);padding:22px;text-align:center}\r\n.pager{display:flex;gap:8px;align-items:center;margin-top:12px;color:var(--muted);font-size:12px}\r\n.pager button{background:#141821;border:1px solid var(--border);color:var(--text);border-radius:7px;padding:4px 10px;cursor:pointer}\r\n.pager button:disabled{opacity:.4;cursor:default}\r\n\r\n/* ---------- bits ---------- */\r\n.btn{background:#141821;border:1px solid var(--border);color:var(--text);border-radius:8px;padding:7px 12px;cursor:pointer;font-size:13px}\r\n.btn:hover{border-color:#333c4d;background:#171c26}\r\n.btn.primary{background:var(--accent);border-color:var(--accent)}\r\n.btn.primary:hover{background:#6b4cf5}\r\n.btn.danger{background:#2a1618;border-color:#4a2226;color:#ff9b9b}\r\n.btn.danger:hover{background:#341a1d}\r\n.btn.wide{width:100%;margin-top:12px}\r\n.btn.sm{padding:4px 9px;font-size:12px}\r\n.pill{display:in"
		+ "line-block;border-radius:999px;padding:1px 9px;font-size:11px;border:1px solid var(--border);color:var(--muted)}\r\n.pill.ok{color:var(--ok);border-color:rgba(61,220,151,.35);background:rgba(61,220,151,.08)}\r\n.pill.bad{color:var(--bad);border-color:rgba(255,107,107,.35);background:rgba(255,107,107,.08)}\r\n.pill.warn{color:var(--warn);border-color:rgba(247,201,72,.35);background:rgba(247,201,72,.08)}\r\n.pill.acc{color:#c4b5fd;border-color:rgba(124,92,255,.4);background:var(--accent-soft)}\r\n.switch{position:relative;display:inline-block;width:40px;height:22px;flex:0 0 40px}\r\n.switch input{display:none}\r\n.switch i{position:absolute;inset:0;background:#222836;border-radius:999px;transition:.15s;cursor:pointer}\r\n.switch i:before{content:\"\";position:absolute;width:16px;height:16px;border-radius:50%;background:#7d8798;top:3px;left:3px;transition:.15s}\r\n.switch input:checked + i{background:var(--accent)}\r\n.switch input:checked + i:before{background:#fff;transform:translateX(18px)}\r\n.field{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;padding:11px 0;border-bottom:1px solid #1b1f28}\r\n.field:last-child{border-bottom:0}\r\n.field .fname{font-size:13px}\r\n.field .fdesc{color:var(--dim);font-size:11.5px;margin-top:2px;max-width:520px}\r\n.field .fctrl{flex:0 0 174px;display:flex;justify-content:flex-end;align-items:center;gap:8px}\r\n.field .fctrl input[type=number],.field .fctrl input[type=text]{width:174px;text-align:right}\r\n.field.changed{background:rgba(124,92,255,.06)}\r\n.field .changeddot{width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:6px}\r\n.savebar{position:sticky;bottom:0;background:linear-gradient(180deg,rgba(21,24,31,.4),var(--card) 40%);border-top:1px solid var(--border);margin:16px -18px -16px;padding:12px 18px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\r\n.savebar .meta{color:var(--muted);font-size:12px;flex:1}\r\npre.log{background:#0b0d12;border:1px solid var(--border);border-radius:10px;padding:12px;max-height:520px;overflow:auto;font-family:var(--mono);font-size:12px;white-space:pre-wrap;word-break:break-all;margin:0}\r\n.tabs2{display:flex;gap:6px;margin-bottom:12px}\r\n.tabs2 button{background:#141821;border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:6px 12px;cursor:pointer;font-size:12.5px}\r\n.tabs2 button.active{background:var(--accent-soft);color:var(--text);border-color:rgba(124,92,255,.4)}\r\n.rail .card{padding:14px}\r\n.rail .danger-title{color:#ff9b9b;font-size:12px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:10px}\r\n.rail .field{padding:9px 0}\r\n.rail .fctrl{flex:0 0 96px}\r\n.rail input{padding:6px 8px;font-size:12px}\r\n.toasts{position:fixed;right:18px;bottom:18px;display:flex;flex-direction:column;gap:8px;z-index:60}\r\n.toast{background:#171c26;border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:10px;padding:10px 14px;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.4);max-width:380px}\r\n.toast.ok{border-left-color:var(--ok)}\r\n.toast.bad{border-left-color:var(--bad)}\r\n.panel{position:absolute;top:60px;right:18px;width:340px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:12px;z-index:50;box-shadow:0 20px 50px rgba(0,0,0,.5);max-height:60vh;overflow:auto}\r\n.panel h4{margin:0 0 8px;font-size:13px}\r\n.panel .item{padding:8px 0;border-bottom:1px solid #1b1f28;font-size:12.5px}\r\n.panel .item:last-child{border-bottom:0}\r\n.panel .item small{display:block;color:var(--dim);font-size:11px}\r\n.kv{display:grid;grid-template-columns:180px 1fr;gap:6px 12px;font-size:13px}\r\n.kv .k{color:var(--muted)}\r\n.kv .v{font-family:var(--mono);font-size:12px;word-break:break-all}\r\ntextarea{font-family:var(--mono);font-size:12px;min-height:96px;resize:vertical}\r\n.perm-row{display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:start;padding:10px 0;border-bottom:1px solid #1b1f28}\r\n.perm-row:last-ch"
		+ "ild{border-bottom:0}\r\n.hintline{color:var(--dim);font-size:11.5px;margin:6px 0 0}\r\n@media (max-width:1200px){.body{grid-template-columns:200px minmax(0,1fr)}.rail{display:none}}\r\n\r\n/* ---------- motion ---------- */\r\n@keyframes seiun-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}\r\n@keyframes seiun-fade{from{opacity:0}to{opacity:1}}\r\n@keyframes seiun-slide{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}\r\n@keyframes seiun-pop{from{opacity:0;transform:scale(.965)}to{opacity:1;transform:none}}\r\n@keyframes seiun-shimmer{0%{background-position:-140% 0}100%{background-position:240% 0}}\r\n@keyframes seiun-spin{to{transform:rotate(360deg)}}\r\n:root{--ease:cubic-bezier(.22,.61,.36,1)}\r\n\r\n/* interactive feedback */\r\na,.btn,.icon-btn,.tab,.tabs2 button,.pager button,.sidebar a,.topnav a,input,textarea,select,\r\n.switch i,.switch i:before,.stat,.card,.me,.avatar,.pill,td,th{\r\n  transition:background-color .18s ease,border-color .18s ease,color .18s ease,box-shadow .22s ease,\r\n    transform .18s var(--ease),opacity .18s ease}\r\n.btn{transition-duration:.14s}\r\n.btn:hover{transform:translateY(-1px)}\r\n.btn:active{transform:translateY(1px) scale(.985)}\r\n.icon-btn:active{transform:scale(.94)}\r\n.sidebar a:hover,.topnav a:hover{transform:translateX(2px)}\r\n.topnav a:hover{transform:none}\r\n.card:hover{border-color:#2b3242}\r\n.stat:hover{transform:translateY(-2px);border-color:#2b3242;box-shadow:0 12px 28px rgba(0,0,0,.3)}\r\n.stat .value{transition:color .2s ease}\r\ntbody tr:hover td{background:#141821}\r\n.pill{transition:transform .16s var(--ease)}\r\n.pill:active{transform:scale(.95)}\r\n\r\n/* route / card entrance (only while #content carries .anim, i.e. on route changes) */\r\n.anim .page-title{animation:seiun-rise .3s var(--ease) both}\r\n.anim .card{animation:seiun-rise .34s var(--ease) both}\r\n.anim .card:nth-of-type(2){animation-delay:.05s}\r\n.anim .card:nth-of-type(3){animation-delay:.09s}\r\n.anim .card:nth-of-type(4){animation-delay:.13s}\r\n.anim .grid > *{animation:seiun-rise .36s var(--ease) both}\r\n.anim .grid > *:nth-child(2){animation-delay:.045s}\r\n.anim .grid > *:nth-child(3){animation-delay:.09s}\r\n.anim .grid > *:nth-child(4){animation-delay:.135s}\r\n.anim .grid > *:nth-child(5){animation-delay:.18s}\r\n.anim .grid > *:nth-child(6){animation-delay:.225s}\r\n.anim .grid > *:nth-child(7){animation-delay:.27s}\r\n.anim .grid > *:nth-child(8){animation-delay:.315s}\r\n.anim tbody tr{animation:seiun-fade .26s ease both}\r\n.anim .savebar{animation:seiun-rise .3s var(--ease) both}\r\n.anim .sidebar a{animation:seiun-slide .26s var(--ease) both}\r\n.anim .rail .card{animation:seiun-rise .38s var(--ease) both}\r\n.app-in{animation:seiun-fade .3s ease both}\r\n\r\n/* login */\r\n.login-card{animation:seiun-pop .32s var(--ease) both}\r\n.tabpane{animation:seiun-fade .22s ease both}\r\n.tabpane.hidden{animation:none}\r\n\r\n/* overlays */\r\n.toast{animation:seiun-slide .26s var(--ease) both}\r\n.toast.leaving{animation:seiun-slide .22s ease reverse both}\r\n.panel{animation:seiun-pop .18s var(--ease) both;transform-origin:top right}\r\n\r\n/* loading skeleton + spinner */\r\n.skeleton{background:linear-gradient(90deg,#15181f 0%,#1e2431 45%,#15181f 90%);background-size:220% 100%;\r\n  animation:seiun-shimmer 1.15s linear infinite;border-radius:8px;height:13px;margin:9px 0}\r\n.skeleton.big{height:22px}\r\n.spin{width:13px;height:13px;border:2px solid #2c3342;border-top-color:var(--accent);border-radius:50%;\r\n  display:inline-block;animation:seiun-spin .8s linear infinite;vertical-align:-2px;margin-right:8px}\r\n.loading-card{padding:18px}\r\n.busy{opacity:.6;pointer-events:none;transition:opacity .15s ease}\r\n\r\n/* accessibility: honour reduced-motion */\r\n@media (prefers-reduced-motion:reduce){\r\n  *,*::before,*::after{animation-duration:.001ms !important;animation-delay:0ms !important;transition-duration:.001ms !important}\r"
		+ "\n}\r\n";

	/** Relative names of the embedded assets, in the order ConsoleWeb looks them up. */
	public static function names():Array<String> {
		return ["index.html", "app.js", "style.css"];
	}

	/** The embedded asset with this exact relative name, or null when there is none. */
	public static function lookup(name:String):Null<String> {
		return switch (name) {
			case "index.html": INDEX_HTML;
			case "app.js": APP_JS;
			case "style.css": STYLE_CSS;
			default: null;
		}
	}

	/** Number of embedded assets; a build without them would report 0 and adapt its 404 text. */
	public static inline function count():Int return 3;
}
